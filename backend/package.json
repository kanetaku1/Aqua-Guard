{
  "name": "aquaguard-backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "node dist/tools/migrate.js",
    "admin:bootstrap": "node --env-file=.env.example --env-file-if-exists=.env dist/tools/bootstrap-admin.js",
    "test:unit": "node --test test/telemetry.test.cjs",
    "test:db:local": "node --env-file=.env.example --env-file-if-exists=.env --test test/migrations.test.cjs",
    "test:auth:local": "node --env-file=.env.example --env-file-if-exists=.env --test test/auth.integration.test.cjs",
    "test:admin:local": "node --env-file=.env.example --env-file-if-exists=.env --test test/admin.integration.test.cjs",
    "test:admin-settings:local": "node --env-file=.env.example --env-file-if-exists=.env --test test/admin-settings.integration.test.cjs",
    "test:sync-status:local": "node --env-file=.env.example --env-file-if-exists=.env --test test/sync-status.integration.test.cjs",
    "test:sensor-history:local": "node --env-file=.env.example --env-file-if-exists=.env --test test/sensor-history.integration.test.cjs",
    "test:sensor-anomalies:local": "node --env-file=.env.example --env-file-if-exists=.env --test test/sensor-anomalies.integration.test.cjs",
    "test:alerts:local": "node --env-file=.env.example --env-file-if-exists=.env --test test/alerts.integration.test.cjs",
    "test:ingestion:local": "node --env-file=.env.example --env-file-if-exists=.env --test test/sensor-ingestion.integration.test.cjs",
    "test:critical:local": "node --env-file=.env.example --env-file-if-exists=.env --test test/critical-evaluation.integration.test.cjs",
    "test:mortality:local": "node --env-file=.env.example --env-file-if-exists=.env --test test/mortality.integration.test.cjs",
    "test:feeding:local": "node --env-file=.env.example --env-file-if-exists=.env --test test/feeding.integration.test.cjs",
    "test:sampling:local": "node --env-file=.env.example --env-file-if-exists=.env --test test/sampling.integration.test.cjs",
    "test:admin-users:local": "node --env-file=.env.example --env-file-if-exists=.env --test test/admin-users.integration.test.cjs",
    "test:password-links:local": "node --env-file=.env.example --env-file-if-exists=.env --test test/password-links.integration.test.cjs",
    "test:bootstrap:local": "node --env-file=.env.example --env-file-if-exists=.env --test test/bootstrap.integration.test.cjs",
    "test:influx:local": "node --env-file=.env.example --env-file-if-exists=.env --test test/influx.integration.test.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "node --env-file=.env.example --env-file-if-exists=.env --watch -r ts-node/register src/main.ts"
  },
  "dependencies": {
    "@influxdata/influxdb-client": "^1.35.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
