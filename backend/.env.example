PORT=8000

# Local Docker Compose only. Use separate credentials outside this development environment.
POSTGRES_PORT=5433
POSTGRES_USER=aquaguard
POSTGRES_PASSWORD=aquaguard-local-postgres
POSTGRES_DB=aquaguard

INFLUXDB_PORT=8086
INFLUXDB_ADMIN_USER=aquaguard_admin
INFLUXDB_ADMIN_PASSWORD=aquaguard-local-influx
INFLUXDB_ADMIN_TOKEN=aquaguard-local-influx-token-change-me
INFLUXDB_ORG=aquaguard
INFLUXDB_BUCKET=sensor_raw

MQTT_PORT=1883
MQTT_ENABLED=false
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_SENSOR_TOPIC_PREFIX=aquaguard/sensors
MQTT_DEVICE_TOPIC_PREFIX=aquaguard/devices
MQTT_ACTUATOR_TOPIC_PREFIX=aquaguard/actuators
MQTT_CLIENT_ID=aquaguard-ingestion-local

# Optional copy from an existing InfluxDB 2.x. Enabled when SOURCE_INFLUX_URL is set (put the
# read-only token in .env). FIELD_MAP pairs each source field with a registered sensor device ID.
SOURCE_INFLUX_URL=
SOURCE_INFLUX_ORG=
SOURCE_INFLUX_BUCKET=
SOURCE_INFLUX_TOKEN=
SOURCE_INFLUX_MEASUREMENT=water_quality
SOURCE_INFLUX_FIELD_MAP=
SOURCE_INFLUX_INVALID_FIELDS=
SOURCE_INFLUX_BACKFILL_HOURS=168
SOURCE_INFLUX_POLL_SECONDS=60

# Local SMTP sink; Mailpit captures messages and never delivers to external recipients.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM="AquaGuard <no-reply@aquaguard.local>"
WEB_APP_ORIGIN=http://localhost:5173
